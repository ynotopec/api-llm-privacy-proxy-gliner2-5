############################
# Server
############################
# Valeurs internes par défaut; décommenter uniquement pour les remplacer.
#HOST=0.0.0.0
#PORT=8088

############################
# Auth API entrante
############################
# Optionnel. Vide par défaut (aucune authentification entrante).
# Plusieurs tokens possibles, séparés par des virgules.
#INBOUND_API_KEYS='change-me'

############################
# Upstream OpenAI-compatible
############################
# Optionnels. Sans UPSTREAM_BASE_URL, le proxy fonctionne en mode anonymisation seule.
#UPSTREAM_BASE_URL='http://127.0.0.1:8000/v1'
#UPSTREAM_API_KEY=''
# false => retourne uniquement le payload anonymisé, sans appeler l'upstream LLM.
#LLM_ENABLED=true

############################
# GLiNER2 Privacy Filter
############################
#PRIVACY_MODEL_ID='fastino/gliner2.5-multi-v1'
#PRIVACY_ENTITY_TYPES='person,full_name,first_name,last_name,date_of_birth,email,phone_number,address,street_address,city,state_or_region,postal_code,country,government_id,national_id_number,passport_number,drivers_license_number,tax_id,bank_account,account_number,iban,payment_card,card_number,username,ip_address,password,api_key,access_token,secret'
# auto | cuda | cpu
#DEVICE=auto
# fp32 | bf16 | fp16 | auto
#TORCH_DTYPE=auto
# Valeur optimale/recommandée pour `fastino/gliner2.5-multi-v1` : `eager`.
# Son encodeur DeBERTaV2 ne prend pas SDPA en charge; `sdpa` provoquerait un
# avertissement puis un fallback vers `eager`. Ne choisir `sdpa` ou
# `flash_attention_2` qu'avec un autre encodeur explicitement compatible.
#GLINER_ATTENTION_IMPLEMENTATION=eager
# Décharge le modèle de la RAM après N secondes d'inactivité (0 = jamais).
#MODEL_IDLE_UNLOAD_SECONDS=300
# Fréquence en secondes du contrôle de déchargement en arrière-plan.
#MODEL_IDLE_CHECK_SECONDS=30
# Score minimum pour accepter une entité détectée.
#MIN_ENTITY_SCORE=0.50
# Limite anti-abus par string.
#MAX_STRING_CHARS=200000
# Taille maximale du corps HTTP, profondeur et nombre de valeurs JSON.
#MAX_REQUEST_BYTES=10485760
#MAX_JSON_DEPTH=64
#MAX_JSON_NODES=100000
# Nombre d'inférences exécutées en parallèle (1 protège la RAM/VRAM par défaut).
#MAX_CONCURRENT_INFERENCES=1

############################
# Redaction
############################
# Clés JSON à ne pas filtrer.
#SKIP_JSON_KEYS='model,role,type,stream,temperature,max_tokens,top_p,tools,tool_choice,name,thinking,reasoning,reasoning_effort'
# Suffixe ajouté aux identifiants de modèles présentés au client.
#MODEL_SUFFIX='-anonym'

############################
# Metrics
############################
# true => /metrics utilise la même authentification que les routes /v1.
#METRICS_REQUIRE_AUTH=true

############################
# Runtime
############################
#LOG_LEVEL=info
#HF_HOME=/data/huggingface
#TRANSFORMERS_CACHE=/data/huggingface
#CUDA_VISIBLE_DEVICES=0
#PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
